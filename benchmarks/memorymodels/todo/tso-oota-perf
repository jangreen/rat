let int = po | po^-1 | id
let rfe = rf-base & ext & loc
let rfi = rf-base & int & loc
let rf = rfi | rfe
let po-loc = po & loc
let fr = rf^-1;co
let dep = [R];(dep-base & po)

// TSO
let com = (co | fr | rf)
let uniproc = (po-loc | com)^+ & id

let com-tso = (co | fr | rfe)
let po-tso = ([R];po | [W];po;[W] | mfence)
let ghb-tso = (po-tso | rfe)^+ & id

let tso = ghb-tso

// OOTA
let oota = (dep | rf)^+ & id

// Assumptions
assume rf & id <= 0
assume po^+ <= po
assume rfi <= po

assume tso <= 0

assert dep;rfe;rfi & id <= 0
assert oota <= 0
