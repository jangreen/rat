let int = po | po^-1 | id
let rfe = rf-base & ext & loc
let rfi = rf-base & int & loc
let rf = rfi | rfe
let po-loc = po & loc
let fr = rf^-1;co

// TSO
let com = (co | fr | rf)
let uniproc = (po-loc | com)^+ & id
let com-tso = (co | fr | rfe)
let po-tso = ([R];po | [W];po;[W] | mfence)
let ghb-tso = (po-tso | com-tso)^+ & id
let tso = ghb-tso | uniproc

// OOTA
let dep = [R];(dep-base & po)
let oota = (dep | rf)^+ & id

//assume rf;rf <= 0
//assume rf & id <= 0
assume po^+ <= po
assume po & id <= 0
//assume loc^-1 <= loc
assume rfi <= po

assume tso <= 0
assert oota <= 0
