// ============ Standard ============
let int = po | po^-1 | id
let rfe = [W];rf-base;[R] & ext & loc
let rfi = [W];rf-base;[R] & int & loc
let rf = rfi | rfe
let po-loc = po & loc
let fr = rf^-1;co

assume W & R <= 0                               // not needed (typing of rfe implies that dep is in po-tso), but faster
assume po^+ <= po
assume po & id <= 0
assume loc^-1 <= loc

// ============ TSO ============
let com = (co | fr | rf)
let uniproc = (po-loc | com)^+ & id             // acyclic (po-loc | com) <=> empty (po-loc | com)+ & id
let com-tso = (co | fr | rfe)
let po-tso = ([R];po | [W];po;[W] | mfence)
let ghb-tso = (po-tso | com-tso)^+ & id         // acyclic (po-tso | com-tso) <=> empty (po-tso | com-tso)+ & id
let tso = ghb-tso | uniproc

// ============ OOTA ============
let dep = dep & po                              // or "assume dep <= po"
let oota = (dep | rf)^+ & id                    // acyclic (dep | rf) <=> empty (dep | rf)+ & id

// ============ Goal ============
assume tso <= 0                                 // assume TSO axioms
assert oota <= 0                                // assert OOTA axioms
