// ========= Common definitions =========
let int = po | po^-1 | id
let rf = [W];rf;[R]
let rfi = rf & int
let rfe = rf & ext
let rf = rfi | rfe
let addr = [R];addr;[M] & po
let data = [R];data;[W] & po
let ctrl = [R];ctrl & po
let M = R | W

// ========= Common assumptions =========
assume W & R <= 0
assume po & id <= 0
assume po+ <= po
assume rfi <= po

// ========= Import VMM =========
let ACQ = ACQ & (R | F)
let REL = REL & (W | F)
include ./benchmarks/demo/vmm/vmm.cat
//assume Marked & Plain <= 0
assume NON-IW & IW <= 0

assume hb+ & id <= 0

// ========= Check OOTA =========
// (1) OOTA plain
let oota-plain = (dep | rf)+ & id   // FALSE: but racy
// assert oota-plain <= 0

// (2) OOTA marked
let oota-marked = ([Marked];(dep | rf);[Marked])+ & id
//assert oota-marked <= 0        // FALSE: (ctrl | rf)-cycle on RLX accesses

// (3) OOTA marked unrolled 4 times
let oota-marked-simple = [Marked];(ctrl);[Marked];(rf);[Marked];(ctrl);[Marked];(rf);[Marked] & id
assert oota-marked-simple <= 0          // FALSE

