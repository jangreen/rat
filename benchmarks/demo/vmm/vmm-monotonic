// ========= Common definitions =========
let int = po | po^-1 | id
let rf = [W];rf;[R]
let rfi = rf & int
let rfe = rf & ext
let rf = rfi | rfe
let addr = [R];addr;[M] & po
let data = [R];data;[W] & po
let ctrl = [R];ctrl & po
let M = R | W

// ========= Common assumptions =========
assume Marked & Plain <= 0
assume W & R <= 0
assume po & id <= 0
assume po+ <= po
assume rfi <= po
assume co & id <= 0
assume co+ <= co
assume NON-IW & IW <= 0
assume M & F <= 0

// ========= Import VMM =========
let DREL = DREL & (W | F)
let DACQ = DACQ & (R | F)

let REL_orig = REL
let ACQ_orig = ACQ
let SC_orig = SC

let REL = REL_orig | DREL
let ACQ = ACQ_orig | DACQ
let SC = SC_orig
include ./benchmarks/demo/vmm/vmm.cat as orig

let REL = REL_orig
let ACQ = ACQ_orig
let SC = SC_orig | DREL | DACQ
include ./benchmarks/demo/vmm/vmm.cat as str

// ========= Check Monotonicity =========
assert orig.hb <= str.hb           // TRUE
assert str.hb <= orig.hb           // FALSE

