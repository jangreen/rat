// ============ Standard ============
let rfe = [W];rf;[R] & ext
let rfi = [W];rf;[R] & int
let rf = rfi | rfe
let po-loc = po & loc
let co = ([W];co;[W])
let coi = co & int
let coe = co & ext
let fr = rf^-1;co
let fri = fr & int
let fre = fr & ext

let data = [R];data;[W] & po
let addr = [R];addr & po
let ctrl = [R];(ctrl & po);po*    // po extends ctrl on hardware models

assume W & R <= 0
assume po^+ <= po
assume po & id <= 0
assume rf <= loc
assume co <= loc
assume loc^-1 <= loc
assume loc* <= loc
assume F & (W | R) <= 0
assume ext+ <= ext
assume ext^-1 <= ext
assume ext;int <= ext

// ============ IMM ============
include ./evaluation/lkmm/lkmm-v00.cat as lkmm
let uniproc = (po-loc | rf | co | fr)+ & id              // uniproc
let hbAcyc = lkmm.hb+ & id                               // acyclic hb
let pbAcyclic = lkmm.pb+ & id                            // acyclic pb
let lkmm = hbAcyc | pbAcyc | uniproc


// ============ MCA ============
let ppo = lkmm.ppo                                        // lkmm's ppo
let mca1 = ((po & loc) | co)+ & id                        // acyclic((po & loc) | co)
// We restrict to Marked accesses to avoid racy examples.
let mca2 = (([Marked];rfe;[Marked];ppo;[Marked];rfe^-1;[Marked]);(coi | coe))+ & id    // acyclic(((rfe;ppo;rfe^-1));co)
let mca = mca1 | mca2

// ============ Goal ============
assume lkmm <= 0
assert mca <= 0                         // FALSE

