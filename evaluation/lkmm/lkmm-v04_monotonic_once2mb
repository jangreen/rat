
// ========= Common definitions =========
let int = po | po^-1 | id
let rf = [W];rf;[R]
let rfi = rf & int
let rfe = rf & ext
let rf = rfi | rfe
let M = R | W

// ========= Common assumptions =========
assume Marked & Plain <= 0
assume W & R <= 0
assume po & id <= 0
assume po+ <= po
assume rfi <= po

// ========= Actual comparison =========
let UP = UP & M     // Only upgrade memory accesses from Once to Mb

let OnceOrig = Once
let MbOrig = Mb

let Once = OnceOrig | UP
let Mb = MbOrig
include ./evaluation/lkmm/lkmm-v04.cat as old

let Once = OnceOrig
let Mb = MbOrig | UP
include ./evaluation/lkmm/lkmm-v04.cat as new

// assert old.hb <= new.hb                    // TIMEOUT
// Thus we instead check that ppo and cumul-fence only get larger (the only relations affected that hb depends on)
// which in turn implies the inclusion on hb.
assert old.ppo         <= new.ppo           // TRUE
assert old.cumul-fence <= new.cumul-fence   // TRUE

// We also check that pb (propagation axiom) is not weakened
// assert old.pb <= new.pb      // TIMEOUT
// The (below) check on strong-fence + the above checks for hb are sufficient to obtain the inclusion
assert old.strong-fence <= new.strong-fence // TRUE

// assert new.hb           <= old.hb           // FALSE
// assert new.strong-fence <= old.strong-fence // FALSE
