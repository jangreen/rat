// PPO (no) subset of PO:
//      https://github.com/torvalds/linux/commit/762e9357e713a2025db05bc36a36a7afc248f9d3

// ========= Common =========
let int = po | po^-1 | id
let rf = [W];rf;[R]
let rfi = rf & int
let rfe = rf & ext
let rf = rfi | rfe
let fr = rf^-1;co
let addr = addr & po
let data = data & po
let ctrl = ctrl & po

let M = R | W

assume W & R <= 0
assume po & id <= 0
assume po+ <= po


// ========= Actual comparison =========
include ./evaluation/lkmm/lkmm-v02.cat as old
include ./evaluation/lkmm/lkmm-v03.cat as new

// Follow from uniproc + basic properties.
assume rfi      <= po
assume fr & int <= po
assume co & int <= po


// ppo is no subset of po in previous version, but it is in the new version
assert old.ppo <= po    // FALSE
assert new.ppo <= po    // TRUE