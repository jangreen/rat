// ============ Standard ============
let int = po | po^-1 | id
let rfe = [W];rf-base;[R] & ext & loc
let rfi = [W];rf-base;[R] & int & loc
let rf = rfi | rfe
let po-loc = po & loc
let fr = rf^-1;co
let M = R | W

assume W & R <= 0
assume po^+ <= po
assume po & id <= 0
assume loc^-1 <= loc

// ============ TSO ============

include ./evaluation/tso/tso.cat as tso
let uniproc = (po-loc | tso.com)^+ & id
let ghb-tso = (tso.po-tso | tso.com-tso)^+ & id
let tso = uniproc | ghb-tso

// ============ OOTA ============
let dep = dep & po                              // or "assume dep <= po"
let oota = (dep | rf)^+ & id                    // acyclic (dep | rf) <=> empty (dep | rf)+ & id

// ============ Goal ============
assume tso <= 0                                 // assume TSO axioms
assert oota <= 0                                // assert OOTA axioms
