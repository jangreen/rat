let rf = [W];rf;[R]
let mo = [W];mo-base;[W]
let fr = fr-imm;mo

let eco = (mo | rf | fr)+


let co1 = (npo-loc | rf | fr | mo)+
// NOTE: Changed npo to npo-loc
let co2 = npo-loc+; eco // remove + for other direction; trivial

assume rfi <= npo-loc
assume [W];npo-loc+;fr-imm?;[W] <= mo-base
assume rf;npo-loc+;[W] <= mo-base
assume rf;npo-loc+;fr <= mo-base

// co2 <= co1

assert [W|R];co2;[W|R] & id <= co1 & id     // TRUE
