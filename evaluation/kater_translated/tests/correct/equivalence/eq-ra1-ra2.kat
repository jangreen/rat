let rfi = [W];rfi;[R]
let rfe = [W];rfe;[R]
let rf = rfi | rfe
let mo = [W];mo-base;[W]
let fr = rf^-1;mo

assume W & R <= 0
assume rf;rf^-1 <= id
assume po+ <= po
assume rfi <= po


let hb1 = (po | rf)+
let ra1 = (hb1;fr | hb1;mo | hb1)

let hb2 = (po;[W] | [R];po | rfe)+
let ra2 = (hb2;fr | hb2;mo | hb2 | po;fr)

assert [R|W];ra1;[R|W] & id <= ra2
assert ra2 & id <= ra1
