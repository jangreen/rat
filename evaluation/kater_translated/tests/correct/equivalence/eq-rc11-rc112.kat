let rf = [W];rf;[R]
let mo = [W];mo;[W]
let fr = rf^-1;mo

assume W & R <= 0
assume rf;rf^-1 <= id
assume rfi <= po
assume po+ <= po
assume SC <= ACQ
assume SC <= REL

include ./evaluation/kater_translated/kat/rc11.kat as rc11
include ./evaluation/kater_translated/kat/rc112.kat as rc112

assert rc11.hb <= rc112.hb | po
assert rc112.hb | po <= rc11.hb

assert rc11.psc <= rc112.psc
assert rc112.psc <= rc11.psc
