let rfi = [W];rfi;[R]
let rfe = [W];rfe;[R]
let rf = rfi | rfe
let mo = [W];mo-base;[W]   // ERROR if mo-base is replaced by mo-base+
let fr = rf^-1;mo

assume F & (R | W) <= 0
assume W & R <= 0
assume rf;rf^-1 <= id
assume po+ <= po
assume po & id <= 0
assume rfi <= po
assume mo-base+ <= mo-base
assume mo-base & id <= 0

include ./evaluation/kater_translated/kat/tso.kat as tso
include ./evaluation/kater_translated/kat/tso-fm.kat as tso-fm

// WTP: tso == fm-tso
// From Lemma 2.1, STP that
//     irreflexive(tso+ | po;eco) <=> irreflexive(hb;fr? | tso-fm+)

let eco = (mo | rf | fr)+

assume (tso-fm.tso+ | tso-fm.hb;fr?) & id <= 0
assert [R|W|F];(tso.tso+ | po;eco);[R|W|F] & id <= 0

//assert (tso-fm.tso+ | tso-fm::hb;fr?) & id <= rot (tso.tso+ | po;eco)
// assert [R|W|F];(tso.tso+ | po;eco);[R|W|F] <=&id rot (tso-fm.tso+ | tso-fm.hb;fr?)
