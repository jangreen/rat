// We have split this test into separate tests for each inclusion direction.

let rf = [W];rf;[R]
let mo = [W];mo-base;[W]
let fr = fr-imm;mo

let eco = (mo | rf | fr)+


let co1 = (npo-loc | rf | fr | mo)+
// NOTE: Changed npo to npo-loc
let co2 = npo-loc+; eco // remove + for other direction; trivial

assume rfi <= npo-loc
assume [W];npo-loc+;fr-imm?;[W] <= mo-base
assume rf;npo-loc+;[W] <= mo-base
assume rf;npo-loc+;fr <= mo-base

// co1 <= co2

// assert [W|R];co1;[W|R] <=&id rot co2 | npo-loc+ | mo+ | eco
// assert co1 <= rot co2 | npo-loc+ | mo+ | eco

assume (co2 | npo-loc+ | mo+ | eco) & id <= 0
assert co1 & id <= 0

// co2 <= co1

assert [W|R];co2;[W|R] & id <= co1 & id
