// Basic theory assumed by Kater (extracted from inspecting the source code; may not be fully accurate)

let UW = W & EXCL
let UR = R & EXCL
let M = R | W

let rmw = [UR];rmw;[UW]
let ctrl = [R];ctrl
let data = [R];data
let addr = [R];addr
let rfe = [W];rfe;[R]
let rfi = [W];rfi;[R]
let rf = rfe | rfi
let mo = [W];mo-base;[W]
let fr = [R];fr-base;[W]

// NOTE:
// We do not define moe, moi, fre, and fri because those are unused in all tested memory models.
// and introducing them would cause problems with our assumptions
// Using the proper definition `let fr = rf^-1;mo` would solve the issue
// but then we would diverge from Kater's formulation.

assume rmw <= po
assume po-loc <= po
assume rfi <= po
assume fr;mo+ <= fr-base
assume po+ <= po
assume mo+ <= mo-base
assume rf;fr <= mo-base
assume R & W <= 0
assume F & (R | W) <= 0
assume RLX & (ACQ | REL) <= 0

// Special assumptions made by Kater
assume SC <= ACQ
assume SC <= REL
