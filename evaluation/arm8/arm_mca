// ============ Standard ============
let rfe = [W];rf;[R] & ext
let rfi = [W];rf;[R] & int
let rf = rfi | rfe
let po-loc = po & loc
let co = ([W];co;[W])
let coi = co & int
let coe = co & ext
let fr = rf^-1;co
let fri = fr & int
let fre = fr & ext

let data = [R];data;[W] & po
let addr = [R];addr & po
let ctrl = [R];(ctrl & po);po*    // po extends ctrl on hardware models

assume W & R <= 0
assume po^+ <= po
assume po & id <= 0
assume loc^-1 <= loc
assume loc* <= loc
assume L & R <= 0
assume ext+ <= ext
assume ext^-1 <= ext
assume ext;int <= ext

// ============ ARM8 ============
include ./evaluation/arm8/aarch64.cat as arm
let external = arm.ob+ & id                         // acyclic ob as external
let internal = (po-loc | arm.ca | rf)+ & id         // acyclic po-loc | ca | rf as internal  (same as uniproc/SC-per-loc)
let arm = external | internal


// ============ MCA ============
let ppo = arm.dob | arm.aob | arm.bob                     // ARM's ppo
let mca1 = ((po & loc) | co)+ & id                        // acyclic((po & loc) | co)
let mca2 = ((rfe;ppo;rfe^-1);(coi | coe))+ & id           // acyclic(((rfe;ppo;rfe^-1));co)
let mca = mca1 | mca2

// ============ Goal ============
assume arm <= 0
assert mca <= 0

