// ============ Standard ============
let int = po | po^-1 | id
let rfe = [W];rf;[R] & ext & loc
let rfi = [W];rf;[R] & int & loc
let rf = rfi | rfe
let po-loc = po & loc
let coi = co & int
let fr = rf^-1;co

assume W & R <= 0
assume po^+ <= po
assume po & id <= 0
assume loc^-1 <= loc

let data = [R];data;[W] & po
let addr = [R];addr & po
let ctrl = [R];(ctrl & po);po*                   // po extends ctrl on hardware models
// let ctrl = [R];(ctrl & po)                     // Language-level ctrl-dep also works for IMM
// ============ IMM ============
include ./evaluation/imm/imm.cat as imm

// ============ OOTA ============
let dep = data | addr | ctrl
let oota = (dep | rf)^+ & id

// ============ Goal ============

assume imm.hb;(imm.eco?) & id <= 0              // assume irreflexive (hb;(eco?))
assume imm.ar+ & id <= 0                        // assume acyclic ar
assert oota <= 0                                // TRUE (even with language-level ctrl-deps!)

